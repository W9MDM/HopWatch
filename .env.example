# HopWatch environment overrides.
# Every config key is overridable via HOPWATCH_<DOTTED_PATH_UPPERCASED>.
# Example: server.port -> HOPWATCH_SERVER_PORT ; database.mysql.password -> HOPWATCH_DATABASE_MYSQL_PASSWORD
#
# Only bootstrap secrets belong here (things needed to reach or decrypt the database).
# Operational settings and secrets (broker/SMTP passwords, Discord client secret, forwarding
# targets, TX, roles, ...) are entered in the admin UI and encrypted at rest in the DB. See
# CLAUDE.md Rule 1.

# Path to the YAML config file (default: ./config/hopwatch.yaml)
HOPWATCH_CONFIG=./config/hopwatch.yaml

# Database password, referenced by ${HOPWATCH_DB_PASSWORD} in the YAML.
HOPWATCH_DB_PASSWORD=hopwatch
# Admin session HMAC key (set a long random value for stable sessions across restarts)
HOPWATCH_SESSION_SECRET=change-me-to-a-long-random-string
# Master key for encrypting UI-entered secrets (broker/SMTP passwords, etc.) at rest in the DB.
# Keep this in env only. If unset, HOPWATCH_SESSION_SECRET is used. Changing it makes
# previously stored secrets undecryptable (re-enter them in the UI).
HOPWATCH_MASTER_KEY=change-me-to-a-different-long-random-string
# Seeded admin password (used once when admin_users is empty)
HOPWATCH_ADMIN_PASSWORD=changeme

# Build metadata (shown in footer + /api/version)
HOPWATCH_GIT_COMMIT=dev
